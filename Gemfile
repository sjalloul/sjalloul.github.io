source "https://rubygems.org"

# Use the same Jekyll + plugin versions GitHub Pages runs, so what you
# see locally matches what gets deployed.
gem "github-pages", group: :jekyll_plugins

# Plugins bundled with github-pages, listed for clarity.
group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
end

# Windows / JRuby helpers (harmless elsewhere)
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
gem "wdm", "~> 0.1.1", platforms: [:mingw, :mswin, :x64_mingw]

# Faster local rebuilds on macOS/Linux
gem "webrick", "~> 1.8"
